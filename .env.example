# Turso (production). Create with:  turso db create billnova && turso db show billnova --url && turso db tokens create billnova
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-token
# Leave both unset for local development: a SQLite file is used at ./data/billnova.db
