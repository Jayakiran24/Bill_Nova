# Turso (production). Create with:  turso db create billnova && turso db show billnova --url && turso db tokens create billnova
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-token
# Leave both unset for local development: a SQLite file is used at ./data/billnova.db

# Google sign-in (optional). Create an OAuth 2.0 Web client at console.cloud.google.com/apis/credentials
# and add these authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production: a long random string (openssl rand -hex 32). Used to hash OTP codes.
AUTH_SECRET=

# Email for OTP codes (any SMTP). Gmail: turn on 2-Step Verification, then create an App Password
# at myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Without these, local dev prints the code in the terminal instead of emailing it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Bill Nova <you@gmail.com>
